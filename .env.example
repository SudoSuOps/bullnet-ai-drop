# Public build-time configuration. Anything prefixed NEXT_PUBLIC_ is embedded in the shipped JavaScript.
# Never put credentials, wallet keys, private endpoints or internal Node addresses in this file or in any NEXT_PUBLIC_ variable.

# Approved, server-backed intake endpoint that accepts a JSON POST and returns 2xx on success.
# Leave empty until one exists: the form then prepares a draft and states plainly that nothing was sent.
NEXT_PUBLIC_INTAKE_ENDPOINT=
